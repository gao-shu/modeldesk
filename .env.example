# Copy values into apps/web/.env.local as needed.

# --- apps/web (Next) ---
# Default 3300 (avoid Hyper-V excluded ranges around 3000–3200 and other apps on 3000)
PORT=3300
NEXT_PUBLIC_APP_NAME=ModelDesk
MODELDESK_DATA_DIR=
# 未设时：源码开发 → 仓库 data/；桌面（MODELDESK_DESKTOP=1）→ %LOCALAPPDATA%\ModelDesk
# 其下：modeldesk.db · artifacts/ · .encryption-secret
# 设置页「更改位置」写入控制目录 data-location.json（开发：.modeldesk/；桌面：同上 AppData）
# Agent bins auto-set MODELDESK_REPO_ROOT; override only if needed.
# MODELDESK_REPO_ROOT=
# Desktop / sidecar: MODELDESK_DESKTOP=1 → default data under %LOCALAPPDATA%\ModelDesk
# MODELDESK_DESKTOP=1
# MODELDESK_WEB_PORT=3300
# MODELDESK_NODE=C:\path\to\node.exe
# Encrypts API keys + object-storage credentials in SQLite.
# Optional: leave unset and click「生成加密密钥」in Settings — writes data/.encryption-secret
# (env wins over that file when both exist). Keep the same secret for an existing DB.
ENCRYPTION_SECRET=change-me-to-a-long-random-secret
# Optional:
# MODELDESK_VIDEO_TIMEOUT_MS=300000

# --- Object storage (optional; for upstreams that need a public URL) ---
# Preferred: Settings UI → 对象存储 (encrypted in SQLite). Needs ENCRYPTION_SECRET (or generated file).
# Below env vars are optional overrides / Docker / CI — UI credentials win when present.
#
# Local artifacts always stay under data/artifacts — cloud upload is only for temp
# public URLs (reference images, etc.).
#
# App enable switch is in Settings (default off). Env STORAGE_PROVIDER is a fallback
# when the UI switch is not used (e.g. headless scripts via createObjectStorageFromEnv).
#
# STORAGE_PROVIDER:
#   none  — default; keep data URI / base64 / local (no cloud)
#   tos   — Volcengine TOS (TOS_*)
#   s3    — S3-compatible AWS / MinIO / gateways (S3_*)
#   oss   — Alibaba Cloud OSS (OSS_*)
#   cos   — Tencent Cloud COS (COS_*)
#   bos   — Baidu Cloud BOS (BOS_*)
# STORAGE_PROVIDER=none

# Volcengine TOS (STORAGE_PROVIDER=tos)
# Object prefix: temp/images|videos|voice — recommend 30-day lifecycle on temp/
# TOS_BUCKET=my-demo-bucket
# TOS_ENDPOINT=tos-cn-beijing.volces.com
# TOS_REGION=cn-beijing
# TOS_ACCESS_KEY=AKLTxxxxxxxxDemoAccessKeyIdxxxxx
# TOS_SECRET_KEY=xxxxxxxxDemoSecretAccessKeyxxxxxxxx
# Optional CDN / custom domain; empty → https://{TOS_BUCKET}.{TOS_ENDPOINT}
# TOS_PUBLIC_BASE_URL=https://my-demo-bucket.tos-cn-beijing.volces.com

# S3-compatible (STORAGE_PROVIDER=s3) — AWS / MinIO / many gateways
# STORAGE_PROVIDER=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=                    # e.g. http://127.0.0.1:9000 for MinIO
# S3_FORCE_PATH_STYLE=1           # often needed for MinIO
# S3_PUBLIC_BASE_URL=             # public/CDN base; empty → derived
# S3_SKIP_ACL=1                   # if bucket rejects object ACL (use bucket policy)

# Alibaba Cloud OSS (STORAGE_PROVIDER=oss)
# STORAGE_PROVIDER=oss
# OSS_BUCKET=
# OSS_REGION=oss-cn-hangzhou
# OSS_ACCESS_KEY=
# OSS_SECRET_KEY=
# OSS_ENDPOINT=                   # optional custom endpoint host/URL
# OSS_PUBLIC_BASE_URL=
# OSS_SKIP_ACL=1

# Tencent Cloud COS (STORAGE_PROVIDER=cos)
# STORAGE_PROVIDER=cos
# COS_BUCKET=                     # e.g. name-appid
# COS_REGION=ap-guangzhou
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_PUBLIC_BASE_URL=
# COS_SKIP_ACL=1

# Baidu Cloud BOS (STORAGE_PROVIDER=bos)
# STORAGE_PROVIDER=bos
# BOS_BUCKET=
# BOS_ENDPOINT=https://bj.bcebos.com
# BOS_ACCESS_KEY=
# BOS_SECRET_KEY=
# BOS_PUBLIC_BASE_URL=

HOST=127.0.0.1
# ALLOW_PROBE_PRIVATE=0
# CORS_ORIGIN=           # default: localhost only; set * only if you accept the risk
