# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# local data (sqlite, artifacts, generated media)
.modeldesk/
/data/artifacts/
/data/_backup*/
/data/adapter-skills/
/data/**/*.sqlite
/data/**/*.sqlite-*
/data/**/*.db
/data/**/*.db-*
/data/.encryption-secret
**/.encryption-secret
/apps/radar-api/data/
*.sqlite
*.sqlite-*
*.db
*.db-shm
*.db-wal
# keep curated open/seed/schema under data/
!/data/seed/
!/data/schema/
!/data/**/.gitkeep

# local scratch / smoke artifacts
.tmp*
tmp-*
test-ref*.png
apps/web/public/test-ref.png
single-run-snapshot.yml
*.png.bak
RELEASE_BODY.md

# env — never commit real secrets (examples are allowlisted)
.env
.env.*
!.env.example
!.env.*.example
.env.local
.env.*.local
.env.docker
apps/web/.env
apps/web/.env.*
!apps/web/.env.example
!**/.env.example
!**/.env.*.example

# next.js
apps/web/.next/
apps/web/out/

# build / cache
dist
build
coverage
*.tsbuildinfo
.turbo

# debug / OS
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
Thumbs.db

# IDE
.idea
.vscode/*
!.vscode/extensions.json

# desktop (Tauri) — engine.zip / runtime must never ship in git
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/runtime/**
!apps/desktop/src-tauri/runtime/.gitkeep
!apps/desktop/src-tauri/runtime/PLACEHOLDER.txt
apps/desktop/src-tauri/resources/
apps/desktop/src-tauri/resources/**
!apps/desktop/src-tauri/resources/.gitkeep
**/engine.zip
engine.zip
apps/radar-api/dist-bundle/
.cache/

# misc
*.pem
.vercel
.codegraph/
.codegraph/**
.playwright-mcp/
*.log
server-out.log
server-err.log
dev-server*.log

# local UI dumps / scratch at repo root (do not publish)
/*.png
/tmp-query-db.mjs
/tmp-*.mjs
