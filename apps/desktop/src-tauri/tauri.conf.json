{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModelDesk",
  "version": "0.2.2",
  "identifier": "com.modeldesk.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "node ../../scripts/build-desktop-runtime.mjs",
    "devUrl": "http://127.0.0.1:3300",
    "frontendDist": "../fallback"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ModelDesk",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/engine.zip"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
