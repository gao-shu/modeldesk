# apps/radar-api — this package does not load dotenv; pass env on the command line
# or export vars in your shell / process manager.

PORT=9800
# Default is loopback. Use 0.0.0.0 only inside Docker / private LAN you control.
HOST=127.0.0.1
# MODELDESK_RADAR_DB= (default: apps/radar-api/data/modeldesk-radar.sqlite)
# MODELDESK_RADAR_ADMIN_TOKEN=change-me
# ALLOW_PROBE_PRIVATE=0
# RADAR_DEMO_CATALOG=0
# CORS_ORIGIN=           # default: localhost only; set * only if you accept the risk
