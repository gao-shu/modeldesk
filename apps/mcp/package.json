{
  "name": "@modeldesk/mcp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "ModelDesk MCP server (stdio) — list_models / run_* over the shared run core",
  "type": "module",
  "bin": {
    "modeldesk-mcp": "./bin/modeldesk-mcp.mjs"
  },
  "files": [
    "bin",
    "src",
    "tsconfig.json",
    "mcp.cursor.example.json"
  ],
  "scripts": {
    "start": "tsx --tsconfig tsconfig.json src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modeldesk/adapters": "workspace:*",
    "@modeldesk/object-storage": "workspace:*",
    "@modeldesk/shared": "workspace:*",
    "@modeldesk/tos-storage": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
