{
  "name": "modeldesk",
  "private": true,
  "version": "0.2.3",
  "description": "ModelDesk — local single-user multimodal API desk",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "node scripts/run-with-port-hint.mjs --service Web --port 3300 --env-hint MODELDESK_WEB_PORT -- pnpm --filter @modeldesk/web dev",
    "build": "pnpm --filter @modeldesk/web build",
    "lint": "pnpm -r --if-present lint",
    "smoke": "node scripts/smoke-phase1.mjs",
    "check:oss": "node scripts/check-oss.mjs",
    "mcp": "pnpm --filter @modeldesk/mcp start",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "cli": "pnpm --filter @modeldesk/cli start",
    "gateway": "pnpm --filter @modeldesk/gateway start",
    "gateway:smoke": "node scripts/gateway-smoke.mjs",
    "gateway:accept": "node scripts/gateway-accept.mjs",
    "install:bins": "node scripts/install-agent-bins.mjs",
    "desktop:sidecar": "node scripts/desktop-sidecar.mjs",
    "desktop:dev": "pnpm --filter @modeldesk/desktop dev",
    "desktop:prepare": "node scripts/build-desktop-runtime.mjs",
    "desktop:build": "pnpm --filter @modeldesk/desktop build",
    "release:sync-gitee": "node scripts/sync-gitee-release.mjs"
  },
  "engines": {
    "node": "^22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sharp",
      "unrs-resolver"
    ]
  }
}
