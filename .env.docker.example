# Copy to .env.docker and edit before: docker compose --env-file .env.docker up --build
#   cp .env.docker.example .env.docker

# Must match the secret used when encrypting API keys in modeldesk.db
ENCRYPTION_SECRET=change-me-to-a-long-random-secret

NEXT_PUBLIC_APP_NAME=ModelDesk
WEB_HOST_PORT=3020
RADAR_HOST_PORT=9800

# Seed radar SQLite on first empty volume (1/0)
SEED_ON_EMPTY=1

# Optional
# MODELDESK_RADAR_ADMIN_TOKEN=
# ALLOW_PROBE_PRIVATE=0

# Optional object storage — prefer Settings UI after container starts (encrypted in
# mounted ./data). Env below is optional fallback for Docker/CI.
# STORAGE_PROVIDER=none
# TOS_BUCKET=
# TOS_ENDPOINT=tos-cn-beijing.volces.com
# TOS_REGION=cn-beijing
# TOS_ACCESS_KEY=
# TOS_SECRET_KEY=
# TOS_PUBLIC_BASE_URL=
# S3 / OSS / COS / BOS — see .env.example
